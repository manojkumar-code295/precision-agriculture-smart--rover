# Precision Agriculture Smart Rover - Environment Configuration Template

# Hardware Pin Verification Flag
# Set to 'true' only after verifying physical wiring on Raspberry Pi GPIO
GPIO_HARDWARE_ENABLED=false

# Motor Driver Pins (BCM Numbers - Dual H-Bridge L298N)
MOTOR_LEFT_IN1=17
MOTOR_LEFT_IN2=27
MOTOR_LEFT_ENA=22
MOTOR_RIGHT_IN3=23
MOTOR_RIGHT_IN4=24
MOTOR_RIGHT_ENB=25
MOTOR_DEFAULT_SPEED=75
MOTOR_COMMAND_TIMEOUT=1.5

# Ultrasonic Obstacle Sensor (HC-SR04)
# Warning: Ensure ECHO pin uses a voltage divider (5V to 3.3V)
ULTRASONIC_ENABLED=false
ULTRASONIC_TRIG=5
ULTRASONIC_ECHO=6
OBSTACLE_SAFETY_DISTANCE_CM=25.0
CRITICAL_STOP_DISTANCE_CM=15.0

# Sprayer Relay Configuration
SPRAYER_ENABLED=false
SPRAYER_PIN=26
DEFAULT_SPRAY_DURATION_SEC=3.0

# AI Detection Parameters
CONFIDENCE_THRESHOLD=70.0

# Cloud Synchronization
CLOUD_API_URL=https://precision-agriculture-smart-rover.onrender.com
CLOUD_API_KEY=smartrover_secure_key_2026
SYNC_INTERVAL_SEC=30

# Local Server Settings
LOCAL_API_HOST=0.0.0.0
LOCAL_API_PORT=5000
