[Unit]
Description=AgriRover AI - Web Dashboard & Local Backend Service
Documentation=https://github.com/manojkumar-code295/precision-agriculture-smart--rover
After=network.target agrirover-camera.service
Wants=network.target

[Service]
Type=simple
User=agrirover
Group=agrirover
WorkingDirectory=/home/agrirover/Plant_Disease_Detection_AI
Environment=PYTHONUNBUFFERED=1
Environment=PORT=5001
Environment=PATH=/home/agrirover/Plant_Disease_Detection_AI/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/agrirover/Plant_Disease_Detection_AI/venv/bin/gunicorn --bind 0.0.0.0:5001 --workers 2 --timeout 60 app:app
Restart=always
RestartSec=5s
KillMode=mixed
TimeoutStopSec=10s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
